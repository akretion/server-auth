<?xml version="1.0" encoding="utf-8" ?>
<odoo>

<template id="report_api_key_barcode">
    <t t-call="web.html_container">
      <div
                t-foreach="[[docs[x:x+2], docs[x+2:x+4]] for x in range(0, len(docs), 4)]"
                t-as="page_docs"
                class="page article"
            >
        <table height="1000">
            <t t-foreach="page_docs" t-as="page_row">
              <tr>
                <t t-foreach="page_row" t-as="o">
                  <td>
                    <div style="text-align: center; font-size: 2em"><span
                                            t-field="o.name"
                                        /></div>
                    <img
                                        t-if="o.key"
                                        class="barcode"
                                        t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;humanreadable=1' % ('Code128', o.key, 600, 150)"
                                        alt="Barcode"
                                    />
                  </td>
                </t>
              </tr>
            </t>
        </table>
      </div>
    </t>
</template>

</odoo>
